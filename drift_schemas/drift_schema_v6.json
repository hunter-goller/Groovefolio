  "fixed_sql": [
    {
      "name": "artists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"artists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "albums",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"albums\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"artist_id\" TEXT NOT NULL REFERENCES artists (id), \"release_year\" INTEGER NULL, \"label\" TEXT NULL, \"artwork_path\" TEXT NULL, \"purchase_date\" TEXT NULL, \"purchase_price_cents\" INTEGER NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "plays",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plays\" (\"id\" TEXT NOT NULL, \"album_id\" TEXT NOT NULL REFERENCES albums (id) ON DELETE CASCADE, \"played_at\" TEXT NOT NULL, \"side_played\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "nfc_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"nfc_tags\" (\"id\" TEXT NOT NULL, \"album_id\" TEXT NOT NULL UNIQUE REFERENCES albums (id) ON DELETE CASCADE, \"nfc_tag_id\" TEXT NOT NULL UNIQUE, \"written_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "genres",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"genres\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL COLLATE NOCASE UNIQUE, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "album_genres",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"album_genres\" (\"album_id\" TEXT NOT NULL REFERENCES albums (id) ON DELETE CASCADE, \"genre_id\" TEXT NOT NULL REFERENCES genres (id) ON DELETE CASCADE, PRIMARY KEY (\"album_id\", \"genre_id\"));"
        }
      ]
    },
    {
      "name": "album_discogs_releases",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"album_discogs_releases\" (\"album_id\" TEXT NOT NULL REFERENCES albums (id) ON DELETE CASCADE, \"release_id\" INTEGER NOT NULL UNIQUE, PRIMARY KEY (\"album_id\"));"
        }
      ]
    },
    {
      "name": "tracks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tracks\" (\"id\" TEXT NOT NULL, \"album_id\" TEXT NOT NULL REFERENCES albums (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"position\" TEXT NULL, \"side\" TEXT NULL, \"sequence\" INTEGER NOT NULL, \"duration_seconds\" INTEGER NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "plays_album_played_at_idx",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX plays_album_played_at_idx ON plays (album_id, played_at)"
        }
      ]
    }
